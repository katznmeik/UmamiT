    <string name="onboarding_app_name">UmamiT</string>
    <string name="onboarding_welcome">For the love of tea</string>
    <string name="onboarding_welcome_japanese">お茶で、いい時間を。</string>
    <string name="onboarding_start">Let\'s go</string>
    <string name="onboarding_reliability_title">So the timer rings reliably</string>
    <string name="onboarding_reliability_intro">A few settings so the alarm reaches you even when the screen is locked. You can catch up on anything missing later in Settings.</string>
    <string name="onboarding_check_notifications">Allow notifications</string>
    <string name="onboarding_check_notifications_explanation">For the alarm and the running infusion.</string>
    <string name="onboarding_check_notifications_action">Allow</string>
    <string name="onboarding_check_battery">Battery: Unrestricted</string>
    <string name="onboarding_check_battery_explanation">So Android doesn\'t put the timer to sleep. On Samsung devices, also add UmamiT to “Never sleeping apps”.</string>
    <string name="onboarding_check_battery_action">Allow</string>
    <string name="onboarding_check_live">Live notifications</string>
    <string name="onboarding_check_live_explanation">Shows the infusion in the status bar and on the lock screen.</string>
    <string name="onboarding_check_live_action">Turn on</string>
    <string name="onboarding_check_full_screen">Full-screen alarm</string>
    <string name="onboarding_check_full_screen_explanation">Shows the alarm over the lock screen.</string>
    <string name="onboarding_check_full_screen_action">Allow</string>
    <string name="onboarding_restart_title">Automatic restart</string>
    <string name="onboarding_restart_body">Samsung sometimes restarts the phone at night. Afterwards a running timer only rings once you\'ve unlocked the phone. Under Battery and device care › Automatic optimization, turn off “Auto restart”.</string>
    <string name="onboarding_restart_link">Open device care</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_save_failed">Couldn\'t save. Tap again; is the storage full?</string>
    <string name="onboarding_catalog_title">Load the catalog</string>
    <string name="onboarding_catalog_body">Make all teas from Tee-Kontor Kiel available offline, from green tea to chai. The first load takes about half an hour; you can use the app in the meantime.</string>
    <string name="onboarding_catalog_load">Load catalog now</string>
    <string name="onboarding_catalog_later">Later</string>
    <string name="onboarding_catalog_starting">Reading the sitemap …</string>
    <string name="onboarding_catalog_progress" tools:ignore="PluralsCandidate">Pages: %1$d of %2$d · Products: %3$d</string>
    <string name="onboarding_catalog_running_hint">The catalog keeps loading in the background, even with the phone locked. You can get started already.</string>
    <plurals name="onboarding_catalog_tea_count">
        <item quantity="one">%1$d tea</item>
