<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Einrichtung (SCR-01): welcome (ONB-01). -->
    <string name="onboarding_app_name">UmamiT</string>
    <string name="onboarding_welcome">Aus Liebe zum Tee</string>
    <string name="onboarding_welcome_japanese">お茶で、いい時間を。</string>
    <string name="onboarding_start">Los geht\'s</string>

    <!-- Reliability page (ONB-02, ONB-06). -->
    <string name="onboarding_reliability_title">Damit der Timer zuverlässig klingelt</string>
    <string name="onboarding_reliability_intro">Ein paar Einstellungen, damit dich der Alarm auch bei gesperrtem Bildschirm erreicht. Was fehlt, kannst du später in den Einstellungen nachholen.</string>
    <string name="onboarding_check_notifications">Benachrichtigungen erlauben</string>
    <string name="onboarding_check_notifications_explanation">Für den Alarm und den laufenden Aufguss.</string>
    <string name="onboarding_check_notifications_action">Erlauben</string>
    <string name="onboarding_check_battery">Akku: Uneingeschränkt</string>
    <string name="onboarding_check_battery_explanation">Damit Android den Timer nicht schlafen legt. Auf Samsung-Geräten zusätzlich UmamiT bei „Nie schlafende Apps“ eintragen.</string>
    <string name="onboarding_check_battery_action">Freigeben</string>
    <string name="onboarding_check_live">Live-Benachrichtigungen</string>
    <string name="onboarding_check_live_explanation">Zeigt den Aufguss in der Statusleiste und auf dem Sperrbildschirm.</string>
    <string name="onboarding_check_live_action">Einschalten</string>
    <string name="onboarding_check_full_screen">Vollbild-Alarm</string>
    <string name="onboarding_check_full_screen_explanation">Zeigt den Alarm über dem Sperrbildschirm.</string>
    <string name="onboarding_check_full_screen_action">Erlauben</string>
    <string name="onboarding_restart_title">Automatischer Neustart</string>
    <string name="onboarding_restart_body">Samsung startet das Handy nachts manchmal neu. Danach klingelt ein laufender Timer erst, wenn du das Handy entsperrt hast. Schalte unter Akku und Gerätewartung › Automatische Optimierung „Automatisch neu starten“ aus.</string>
    <string name="onboarding_restart_link">Gerätewartung öffnen</string>
    <string name="onboarding_photos_loading">Teefotos werden geladen …</string>
    <string name="onboarding_photos_skip">Überspringen</string>
    <string name="onboarding_next">Weiter</string>
    <string name="onboarding_save_failed">Konnte nicht gespeichert werden. Tippe noch einmal; ist der Speicher voll?</string>

    <!-- Catalog page (ONB-03, SCR-01 page 3; CAT-07). -->
    <string name="onboarding_catalog_title">Katalog laden</string>
    <string name="onboarding_catalog_body">Alle Grüntees von Tee-Kontor Kiel offline verfügbar machen. Das erste Laden dauert etwa eine Viertelstunde; die App kannst du währenddessen schon nutzen.</string>
    <string name="onboarding_catalog_load">Katalog jetzt laden</string>
    <string name="onboarding_catalog_later">Später</string>
    <string name="onboarding_catalog_starting">Sitemap wird gelesen …</string>
    <!-- „von" is no noun: nothing to pluralise. -->
    <string name="onboarding_catalog_progress" tools:ignore="PluralsCandidate">Seiten: %1$d von %2$d · Produkte: %3$d</string>
    <string name="onboarding_catalog_running_hint">Der Katalog lädt im Hintergrund weiter, auch bei gesperrtem Handy. Du kannst schon loslegen.</string>
    <plurals name="onboarding_catalog_tea_count">
        <item quantity="one">%1$d Grüntee</item>
        <item quantity="other">%1$d Grüntees</item>
    </plurals>
    <string name="onboarding_catalog_done">Katalog geladen: %1$s</string>
    <string name="onboarding_catalog_cancelled">Laden abgebrochen. Du kannst den Katalog später unter Sammlung › Katalog laden.</string>
    <string name="onboarding_catalog_failed">Der Katalog konnte gerade nicht geladen werden. Du kannst es später unter Sammlung › Katalog noch einmal versuchen.</string>
</resources>
