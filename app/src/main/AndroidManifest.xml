<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Timer permissions (04 §13; complete app list: 06 §5.7, enforced by
         `checkManifestPermissions`). The reliability card in the settings
         (TMR-31) shows the state of the user-controlled ones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Not in the public SDK 36 stubs; on Android 16 promotion is governed by
         NotificationManager.canPostPromotedNotifications() (user setting).
         Declared as listed in 04 §13 / 06 §5.7; unknown names are ignored. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The catalog refresh's own foreground service (06 §5.3, CAT-07 AC1; #65). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Sideloaded app, never reviewed by Play (D-013, 04 §6.4): the exemption
         from battery optimisation keeps the timer reliable on One UI. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".UmamitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UmamiT">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The share target (CAT-17 AC1, 06 §5.7, D-094): UmamiT in the browser's Teilen sheet.
             Exported for ACTION_SEND with text/plain only and no new permission; it shows
             nothing, hands the untrusted text to MainActivity in the app's own task and finishes. -->
        <activity
            android:name=".ShareTeaLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The catalog refresh notifications' tap (SCR-22, 06 §5.7, #121): not exported and
             without an intent filter, so only the app's own notification starts it. It shows
             nothing, lets the tap through to MainActivity in this process and finishes, in a
             task of its own that never shows in the recent apps. -->
        <activity
            android:name=".CatalogRefreshTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
