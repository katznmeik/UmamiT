# Formatting rules for editors and for ktlint (run by Spotless, 06 §7).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Kotlin official coding conventions (= `kotlin.code.style=official` in
# gradle.properties); ktlint calls this code style `intellij_idea`.
ktlint_code_style = intellij_idea
max_line_length = 120
trim_trailing_whitespace = true
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are named like types (PascalCase).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,toml}]
indent_size = 2
trim_trailing_whitespace = true
