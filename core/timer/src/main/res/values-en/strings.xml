<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Notification channels (04 §8.1) -->
    <string name="timer_channel_brew_timer_name">Infusion timer</string>
    <string name="timer_channel_brew_timer_description">The running infusion as a Live Update</string>
    <string name="timer_channel_steep_finished_name">Infusion done</string>
    <string name="timer_channel_steep_finished_description">Alarm at the end of an infusion</string>
    <string name="timer_channel_sessions_name">Sessions</string>
    <string name="timer_channel_sessions_description">Automatically saved sessions</string>
    <string name="timer_channel_other_name">Second timer</string>
    <string name="timer_channel_other_description">The second running timer, silent next to the infusion</string>
    <string name="timer_text_quick_held">Done, waiting for the infusion</string>
