    <string name="timer_chip_ready">Ready</string>
    <string name="timer_chip_temp">%1$d °C</string>
    <string name="timer_chip_cold">Cold water</string>
    <string name="timer_chip_ice">Ice cubes</string>
    <string name="timer_chip_paused">Paused</string>
    <string name="timer_chip_finished">Done</string>

    <!-- Alert (04 §8.2, full-screen alert) -->
    <string name="timer_alert_title">Pour now!</string>
    <!-- Gyokuro · Infusion 2 -->
    <string name="timer_alert_text">%1$s · %2$s %3$d</string>

    <!-- Notification actions (04 §8.2, §10; TMR-41) -->
    <string name="timer_action_start">Start</string>
    <string name="timer_action_pause">Pause</string>
    <string name="timer_action_resume">Resume</string>
    <string name="timer_action_poured">Poured</string>
    <string name="timer_action_poured_rinse">Poured off</string>
    <string name="timer_action_quick_done">Done</string>
    <string name="timer_action_finish_session">End session</string>
    <string name="timer_action_cancel">Cancel</string>

    <!-- „Session saved" (TMR-14, NotifySessionSaved) -->
    <string name="timer_session_saved_title">Session saved</string>
    <string name="timer_session_saved_text">%1$s · in the journal</string>
    <string name="timer_session_saved_text_no_tea">In the journal</string>

    <!-- After a reboot the session goes on (04 §7.3, D-063) -->
    <string name="timer_resumed_title">Your timer is still running</string>
    <string name="timer_resumed_text">%1$s · after the restart</string>
    <!-- Both timers survived the reboot: one notice names both, the brew first (04 §7.3, D-098) -->
    <string name="timer_resumed_title_both">Your timers are still running</string>
    <string name="timer_resumed_text_both">%1$s and %2$s · after the restart</string>
