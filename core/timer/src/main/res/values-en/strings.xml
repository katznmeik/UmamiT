    <string name="timer_quick_title">Quick timer</string>
    <string name="timer_step_infusion">Infusion</string>
    <string name="timer_step_rinse">Rinse</string>
    <string name="timer_step_whisk">Whisk</string>
    <!-- Gyokuro · Infusion 2 of 3 -->
    <string name="timer_title_step" tools:ignore="PluralsCandidate">%1$s · %2$s %3$d of %4$d</string>
    <string name="timer_title_finished">%1$s · All infusions done</string>
    <!-- Ready · 0:20 -->
    <string name="timer_text_ready">Ready · %1$s</string>
    <!-- Ready · 0:20 · Kettle at 60 °C -->
    <string name="timer_text_ready_kettle">Ready · %1$s · Kettle at %2$d °C</string>
    <!-- At most 10 °C (BRW-10, as SCR-05): Cold water / Ice cubes for an ice brew -->
    <string name="timer_text_ready_cold">Ready · %1$s · Cold water</string>
    <string name="timer_text_ready_ice">Ready · %1$s · Ice cubes</string>
    <string name="timer_text_running">Steeping …</string>
    <string name="timer_text_running_temp">Steeping at %1$d °C</string>
    <string name="timer_text_pre_alert">Almost done …</string>
    <!-- Long step (TMR-18): Done at 14:30 -->
    <string name="timer_text_long_step">Done at %1$s</string>
    <string name="timer_text_paused">Paused · %1$s left</string>
    <string name="timer_text_finished">Tap to finish</string>
