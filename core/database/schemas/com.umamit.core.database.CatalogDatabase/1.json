        "contentSyncTriggers": [
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_catalog_fts_BEFORE_UPDATE BEFORE UPDATE ON `catalog_tea` BEGIN DELETE FROM `catalog_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_catalog_fts_BEFORE_DELETE BEFORE DELETE ON `catalog_tea` BEGIN DELETE FROM `catalog_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_catalog_fts_AFTER_UPDATE AFTER UPDATE ON `catalog_tea` BEGIN INSERT INTO `catalog_fts`(`docid`, `name`, `secondary_name`, `description_text`, `cultivar`, `origin_region`) VALUES (NEW.`rowid`, NEW.`name`, NEW.`secondary_name`, NEW.`description_text`, NEW.`cultivar`, NEW.`origin_region`); END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_catalog_fts_AFTER_INSERT AFTER INSERT ON `catalog_tea` BEGIN INSERT INTO `catalog_fts`(`docid`, `name`, `secondary_name`, `description_text`, `cultivar`, `origin_region`) VALUES (NEW.`rowid`, NEW.`name`, NEW.`secondary_name`, NEW.`description_text`, NEW.`cultivar`, NEW.`origin_region`); END"
