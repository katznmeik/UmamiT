    <!-- The share text (PRF-08 AC1, GEN-10): English when the app is English; the recipe file itself is unchanged.
         %1$s the tea, %2$s the recipe's name. -->
    <string name="recipe_file_share_title">%1$s – Recipe “%2$s”</string>
    <!-- %1$s the tea, %2$s its secondary name, %3$s the recipe's name. -->
    <string name="recipe_file_share_title_secondary">%1$s (%2$s) – Recipe “%3$s”</string>
    <string name="recipe_file_share_separator">" · "</string>
    <!-- %1$s the leaf („4.0 g"), %2$s the water („120 ml"). -->
    <string name="recipe_file_share_amounts">%1$s per %2$s</string>
    <!-- %1$s the vessel type („Kyusu"). -->
    <string name="recipe_file_share_vessel">Vessel: %1$s</string>
    <!-- A number and its unit are joined by a no-break space (05 §7). -->
    <string name="recipe_file_share_grams">%1$s g</string>
    <string name="recipe_file_share_ml">%1$d ml</string>
    <string name="recipe_file_share_celsius">%1$d °C</string>
    <!-- %1$d the step's number, %2$s its kind („1. Infusion"). -->
    <string name="recipe_file_share_step">%1$d. %2$s</string>
